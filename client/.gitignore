# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
score-web/node_modules/

# Generated by score-web/build.mjs at install time (postinstall / eas-build-post-install).
# 1.5 MB of bundled OSMD + Tone.js — committing it churned the whole blob through git
# history on every score-web change, and a stale copy could ship silently.
src/score-web/html.ts

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# NativeWind (auto-generated by Metro, committed manually as nativewind-env.d.ts)
# nativewind-env.d.ts is intentionally tracked in git

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
